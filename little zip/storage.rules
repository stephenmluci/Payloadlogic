rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // All files & receipts: Allow full read and write access for all authenticated users (Admins & Drivers)
    match /receipts/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /signed_bols/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /outbound_bols/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Global dev fallback for all paths
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
